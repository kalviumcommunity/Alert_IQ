# OpenAI-compatible API Configuration (e.g., Google Gemini OpenAI-compatible endpoint, OpenAI, Ollama, Groq, etc.)
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_API_KEY=your_api_key_here
